---
// Accessible FAQ list built on <details>. Answers may contain simple HTML (links).
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((it) => (
      <details class="faq__item" data-reveal>
        <summary data-cursor="link">
          <span>{it.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__a" set:html={it.a} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 12px;
  }

  .faq__item {
    border-radius: var(--radius-m);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: var(--card-shadow);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .faq__item[open] {
    background: rgba(156, 136, 255, 0.08);
    box-shadow: var(--card-shadow-accent);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 26px;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(18px, 1.6vw, 21px);
    letter-spacing: -0.02em;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.07);
    transition:
      transform 0.45s var(--ease-bounce),
      background-color 0.3s ease;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    border-radius: 2px;
    background: var(--text);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--primary);
  }

  .faq__item[open] .faq__icon::before,
  .faq__item[open] .faq__icon::after {
    background: var(--primary-ink);
  }

  .faq__a {
    padding: 0 26px 24px;
    color: var(--text-2);
    max-width: 70ch;
    animation: faq-in 0.45s var(--ease-out);
  }

  .faq__a :global(p + p) {
    margin-top: 10px;
  }

  .faq__a :global(a) {
    color: var(--primary-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
