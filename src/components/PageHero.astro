---
// Top of every inner page: eyebrow, big headline, lede, and optional floating 3D art.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  art?: ImageMetadata[];
  compact?: boolean;
}
const { eyebrow, title, lede, art = [], compact = false } = Astro.props;
const spots = [
  { x: "78%", y: "18%", s: 150, r: 10, d: 0.9 },
  { x: "88%", y: "58%", s: 110, r: -12, d: 0.6 },
  { x: "66%", y: "70%", s: 90, r: 8, d: 1.2 },
];
---

<section class:list={["ph", { "ph--compact": compact }]} data-hero>
  {
    art.slice(0, 3).map((img, i) => (
      <div
        class="ph__art"
        style={`left:${spots[i].x};top:${spots[i].y};--s:${spots[i].s}px;--r:${spots[i].r}deg`}
        data-depth={spots[i].d}
        aria-hidden="true"
      >
        <Image src={img} alt="" width={spots[i].s * 2} loading="eager" />
      </div>
    ))
  }
  <div class="wrap ph__inner">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h1 class="ph__title" data-split set:html={title} />
    {lede && <p class="lede ph__lede" data-reveal>{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .ph {
    position: relative;
    padding: clamp(150px, 22vh, 220px) 0 clamp(60px, 10vh, 110px);
    overflow: hidden;
  }

  .ph--compact {
    padding-bottom: 40px;
  }

  .ph__inner {
    position: relative;
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .ph__title {
    font-size: clamp(44px, 7vw, 104px);
    line-height: 1;
    max-width: 14ch;
  }

  .ph__lede {
    max-width: 46ch;
  }

  .ph__art {
    position: absolute;
    width: var(--s);
    height: var(--s);
    rotate: var(--r);
    filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.5));
  }

  .ph__art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: ph-bob 7s ease-in-out infinite;
  }

  .ph__art:nth-child(odd) img {
    animation-delay: -3s;
  }

  @keyframes ph-bob {
    50% {
      transform: translateY(-14px) rotate(5deg);
    }
  }

  @media (max-width: 900px) {
    .ph__art {
      --s: 64px !important;
      opacity: 0.55;
    }
    .ph__art:nth-of-type(n + 2) {
      display: none;
    }
    .ph__art:first-of-type {
      left: auto !important;
      right: 16px;
      top: 96px !important;
    }
  }
</style>
