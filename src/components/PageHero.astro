---
// Top of every inner page: big headline, lede, and optional floating 3D art.
// No eyebrow label: it only repeated the page name, which the nav already shows.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  lede?: string;
  art?: ImageMetadata[];
  /** A cini buddy on the left, in place of the floating art. `still` is shown to people who asked for less motion. */
  buddy?: { src: string; still?: string };
  compact?: boolean;
  /** The title is a whole sentence, so it is set smaller. */
  long?: boolean;
}
const { title, lede, art = [], buddy, compact = false, long = false } = Astro.props;
const spots = [
  { x: "78%", y: "18%", s: 150, r: 10, d: 0.9 },
  { x: "88%", y: "58%", s: 110, r: -12, d: 0.6 },
  { x: "66%", y: "70%", s: 90, r: 8, d: 1.2 },
];
---

<section class:list={["ph", { "ph--compact": compact, "ph--long": long }]} data-hero>
  {
    !buddy &&
    art.slice(0, 3).map((img, i) => (
      <div
        class="ph__art"
        style={`left:${spots[i].x};top:${spots[i].y};--s:${spots[i].s}px;--r:${spots[i].r}deg`}
        data-depth={spots[i].d}
        aria-hidden="true"
      >
        <Image src={img} alt="" width={spots[i].s * 2} loading="eager" />
      </div>
    ))
  }
  <div class:list={["wrap ph__inner", { "ph__inner--buddy": buddy }]}>
    {
      buddy && (
        <picture class="ph__buddy">
          {buddy.still && <source media="(prefers-reduced-motion: reduce)" srcset={buddy.still} />}
          <img src={buddy.src} alt="" width="512" height="512" decoding="async" />
        </picture>
      )
    }
    <div class="ph__text">
      <h1 class="ph__title" data-split set:html={title} />
      {lede && <p class="lede ph__lede" data-reveal>{lede}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .ph {
    position: relative;
    padding: clamp(150px, 22vh, 220px) 0 clamp(60px, 10vh, 110px);
    overflow: hidden;
  }

  .ph--compact {
    padding-bottom: 40px;
  }

  .ph__inner {
    position: relative;
  }

  .ph__text {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .ph__inner--buddy {
    display: flex;
    align-items: center;
    gap: clamp(8px, 3vw, 44px);
  }

  .ph__buddy {
    flex: none;
    width: clamp(210px, 25vw, 330px);
    margin: -14px 0 -14px -24px;
  }

  .ph__buddy img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ph__title {
    font-size: clamp(44px, 7vw, 104px);
    line-height: 1;
    max-width: 14ch;
  }

  .ph--long .ph__title {
    font-size: clamp(32px, 5.2vw, 72px);
    line-height: 1.08;
    max-width: 22ch;
  }

  .ph__lede {
    max-width: 46ch;
  }

  .ph__art {
    position: absolute;
    width: var(--s);
    height: var(--s);
    rotate: var(--r);
    filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.5));
  }

  .ph__art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: ph-bob 7s ease-in-out infinite;
  }

  .ph__art:nth-child(odd) img {
    animation-delay: -3s;
  }

  @keyframes ph-bob {
    50% {
      transform: translateY(-14px) rotate(5deg);
    }
  }

  @media (max-width: 900px) {
    /* Phone: the buddy stays beside the headline; the lede runs full width underneath. */
    .ph__inner--buddy {
      display: grid;
      grid-template-columns: 116px minmax(0, 1fr);
      column-gap: 6px;
      row-gap: 18px;
      align-items: center;
    }
    .ph__inner--buddy .ph__text {
      display: contents;
    }
    .ph__inner--buddy .ph__title {
      grid-column: 2;
      grid-row: 1;
      font-size: clamp(36px, 10.5vw, 48px);
    }
    .ph__inner--buddy .ph__lede {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .ph__buddy {
      grid-column: 1;
      grid-row: 1;
      width: 132px;
      margin: -14px 0 -14px -22px;
    }
    .ph__art {
      --s: 64px !important;
      opacity: 0.55;
    }
    .ph__art:nth-of-type(n + 2) {
      display: none;
    }
    .ph__art:first-of-type {
      left: auto !important;
      right: 16px;
      top: 96px !important;
    }
  }
</style>
