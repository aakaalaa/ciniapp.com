---
// The app's Help link (and older links) open /support. The page now lives at /contact, so forward there and keep the
// ?from=app&app=...&os=... details and any #message with it: the contact form reads them.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>cini</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://ciniapp.com/contact/" />
    <noscript><meta http-equiv="refresh" content="0; url=/contact/" /></noscript>
    <style>
      html {
        background: #0c0c0e;
        color-scheme: dark;
      }
    </style>
    <script is:inline>
      location.replace("/contact/" + location.search + location.hash);
    </script>
  </head>
  <body></body>
</html>
