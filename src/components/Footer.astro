---
import { site } from "../site";

const year = new Date().getFullYear();
const cols = [
  {
    title: "product",
    links: [
      { href: "/how-it-works", label: "how it works" },
      { href: "/#waitlist", label: "join the waitlist" },
    ],
  },
  {
    title: "company",
    links: [
      { href: "/about", label: "about us" },
      { href: "/contact#message", label: "contact" },
    ],
  },
  {
    title: "help",
    links: [
      { href: "/contact", label: "faq" },
      { href: "/delete-account", label: "delete your account" },
    ],
  },
  {
    title: "legal",
    links: [
      { href: "/privacy", label: "privacy policy" },
      { href: "/terms", label: "terms of use" },
    ],
  },
];

const socials = [
  { key: "instagram", label: "Instagram", url: site.social.instagram },
  { key: "tiktok", label: "TikTok", url: site.social.tiktok },
  { key: "youtube", label: "YouTube", url: site.social.youtube },
  { key: "linkedin", label: "LinkedIn", url: site.social.linkedin },
].filter((s) => s.url);
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <div class="foot__hello">
        <p class="foot__kicker">questions, ideas, love letters?</p>
        <a class="foot__mail" href={site.messageUrl} data-cursor="link">message us →</a>
        {
          socials.length > 0 && (
            <ul class="foot__social" aria-label="Cini on social media">
              {socials.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} data-cursor="link">
                    {s.key === "instagram" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                      </svg>
                    )}
                    {s.key === "tiktok" && (
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z" />
                      </svg>
                    )}
                    {s.key === "youtube" && (
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z" />
                      </svg>
                    )}
                    {s.key === "linkedin" && (
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.6h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.6 4.77 6V21h-4v-5.1c0-1.22-.02-2.8-1.7-2.8-1.71 0-1.97 1.33-1.97 2.7V21h-4V9.75Z" />
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <nav class="foot__cols" aria-label="Footer">
        {
          cols.map((c) => (
            <div>
              <h3>{c.title}</h3>
              <ul>
                {c.links.map((l) => (
                  <li>
                    <a href={l.href} data-cursor="link">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="foot__base">
      <p>© {year} cini. all rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    padding: 120px 0 32px;
    border-top: 1px solid var(--line);
    background: var(--bg);
    overflow: hidden;
  }

  .foot__top {
    display: grid;
    grid-template-columns: 1.1fr 1.4fr;
    gap: 64px;
  }

  .foot__kicker {
    color: var(--text-2);
    margin-bottom: 10px;
  }

  .foot__mail {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 40px);
    letter-spacing: -0.03em;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.5s var(--ease-out);
  }

  .foot__mail:hover {
    background-size: 100% 2px;
  }

  .foot__social {
    display: flex;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .foot__social a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-2);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.4s var(--ease-bounce);
  }

  .foot__social a:hover {
    color: var(--primary-ink);
    background: var(--primary);
    transform: translateY(-3px) rotate(-6deg);
  }

  .foot__social svg {
    width: 20px;
    height: 20px;
  }

  .foot__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .foot__cols h3 {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-3);
    margin-bottom: 16px;
  }

  .foot__cols ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .foot__cols a {
    color: var(--text-2);
    font-size: 15px;
    transition: color 0.2s ease;
  }

  .foot__cols a:hover {
    color: var(--text);
  }

  .foot__base {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--text-3);
  }

  @media (max-width: 900px) {
    .foot {
      padding-top: 80px;
    }
    .foot__top {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .foot__cols {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 36px;
    }
    .foot__base {
      flex-direction: column;
    }
  }
</style>
