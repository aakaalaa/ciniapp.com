---
// A CSS iPhone frame around one or more real app screenshots (1179x2556).
// With several screens, they stack and the active one shows (see data-screen).
// Slot content (a coded screen such as <MoodScreen />) becomes screen 0.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  screens?: { src: ImageMetadata; alt: string }[];
  eager?: boolean;
  class?: string;
  width?: number;
}

const { screens = [], eager = false, class: cls, width = 360 } = Astro.props;
const hasSlot = Astro.slots.has("default");
const offset = hasSlot ? 1 : 0;
---

<div class:list={["phone", cls]} style={`--w:${width}px`}>
  <div class="phone__body">
    <div class="phone__screen">
      {
        hasSlot && (
          <div class="phone__img phone__html is-active" data-screen="0">
            <slot />
          </div>
        )
      }
      {
        screens.map((s, i) => (
          <Image
            src={s.src}
            alt={s.alt}
            widths={[560, 840, 1179]}
            quality={90}
            sizes={`${width}px`}
            loading={eager && i === 0 ? "eager" : "lazy"}
            class:list={["phone__img", { "is-active": i + offset === 0 }]}
            data-screen={i + offset}
          />
        ))
      }
      <span class="phone__island" aria-hidden="true"></span>
      <span class="phone__glare" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: min(var(--w), 78vw);
    aspect-ratio: 1179 / 2556;
    transform-style: preserve-3d;
  }

  .phone__body {
    position: absolute;
    inset: -3.2%;
    border-radius: 15% / 7%;
    padding: 3.2% 3.6%;
    background:
      linear-gradient(145deg, #4a4a52 0%, #1d1d22 30%, #0d0d10 60%, #3a3a42 100%);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12) inset,
      0 0 0 2px #050506 inset,
      0 50px 100px -30px rgba(0, 0, 0, 0.9),
      0 30px 80px -40px rgba(156, 136, 255, 0.55);
  }

  /* side buttons */
  .phone__body::before,
  .phone__body::after {
    content: "";
    position: absolute;
    width: 1.2%;
    border-radius: 2px;
    background: #2a2a30;
  }
  .phone__body::before {
    left: -1%;
    top: 22%;
    height: 7%;
    box-shadow: 0 11vmin 0 #2a2a30;
  }
  .phone__body::after {
    right: -1%;
    top: 28%;
    height: 11%;
  }

  .phone__screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 12.5% / 5.8%;
    overflow: hidden;
    background: #000;
    container-type: inline-size;
  }

  .phone__html {
    pointer-events: none;
  }

  .phone__html.is-active {
    pointer-events: auto;
  }

  .phone__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.9s var(--ease-out);
  }

  .phone__img.is-active {
    opacity: 1;
    transform: none;
  }

  .phone__island {
    position: absolute;
    top: 1.6%;
    left: 50%;
    width: 30%;
    height: 4%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
  }

  .phone__island {
    pointer-events: none;
  }

  .phone__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 40%,
      rgba(255, 255, 255, 0.07) 48%,
      transparent 56%
    );
    background-size: 250% 100%;
    background-position: var(--glare, 100%) 0;
  }
</style>
